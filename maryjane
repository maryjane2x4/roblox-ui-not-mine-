-- Keybind Extension
function Library:AddKeybind(Parent, Properties)
    local Properties = Properties or {}
    local Keybind = {
        Value = Properties.Default or Enum.KeyCode.Unknown,
        Mode = Properties.Mode or "Toggle"
    }
    
    local KeybindFrame = Create("Frame", {
        Name = Properties.Name .. "Keybind",
        Parent = Parent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 25)
    })
    
    local KeybindButton = Create("TextButton", {
        Name = "Button",
        Parent = KeybindFrame,
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -60, 0, 2),
        Size = UDim2.new(0, 55, 0, 20),
        Font = Library.Font,
        Text = Keybind.Value.Name ~= "Unknown" and Keybind.Value.Name or "...",
        TextColor3 = Library.Theme.Text,
        TextSize = 10
    })
    
    local KeybindCorner = Create("UICorner", {
        CornerRadius = UDim.new(0, 4),
        Parent = KeybindButton
    })
    
    local KeybindStroke = Create("UIStroke", {
        Color = Library.Theme.Border,
        Thickness = 1,
        Parent = KeybindButton
    })
    
    local Listening = false
    
    local function Set(Key)
        Keybind.Value = Key
        KeybindButton.Text = Key.Name ~= "Unknown" and Key.Name or "..."
        if Properties.Flag then
            Library.Flags[Properties.Flag] = Key
        end
        if Properties.Callback then
            Properties.Callback(Key)
        end
    end
    
    KeybindButton.MouseButton1Click:Connect(function()
        Listening = true
        KeybindButton.Text = "..."
    end)
    
    Connect(UserInputService.InputBegan, function(Input)
        if Listening and Input.UserInputType == Enum.UserInputType.Keyboard then
            Listening = false
            Set(Input.KeyCode)
        end
    end)
    
    if Properties.Flag then
        Library.Items[Properties.Flag] = {
            Type = "Keybind",
            Mode = Keybind.Mode,
            Value = Keybind.Value,
            Set = function(Value)
                Keybind.Value = Value
                KeybindButton.Text = Value.Name ~= "Unknown" and Value.Name or "..."
            end,
            Get = function() return Keybind.Value end
        }
    end
    
    return KeybindFrame
end

return Library
