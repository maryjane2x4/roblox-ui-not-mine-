-- Utility Functions
local function MakeDraggable(Instance, Callback)
    local Dragging = false
    local DragInput = nil
    local DragStart = nil
    local StartPos = nil

    Instance.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
            DragStart = Input.Position
            StartPos = Instance.Position

            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    Instance.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            DragInput = Input
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if Input == DragInput and Dragging then
            local Delta = Input.Position - DragStart
            Instance.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
            if Callback then
                Callback(Instance.Position)
            end
        end
    end)
end

local function Tween(Instance, Properties, Duration, EasingStyle, EasingDirection)
    local Tween = TweenService:Create(Instance, TweenInfo.new(Duration or 0.25, EasingStyle or Enum.EasingStyle.Quart, EasingDirection or Enum.EasingDirection.Out), Properties)
    Tween:Play()
    return Tween
end

local function Create(Class, Properties)
    local Instance = Instance.new(Class)
    for Property, Value in pairs(Properties or {}) do
        Instance[Property] = Value
    end
    return Instance
end

local function Connect(Signal, Callback)
    local Connection = Signal:Connect(Callback)
    table.insert(Library.Connections, Connection)
    return Connection
end

local function DisconnectAll()
    for _, Connection in pairs(Library.Connections) do
        Connection:Disconnect()
    end
end

local function GetTextSize(Text, Font, Size)
    return TextService:GetTextSize(Text, Size, Font, Vector2.new(9e9, 9e9))
end

-- Library Functions
function Library:Notification(Text, Duration, Color)
    local Duration = Duration or 5
    local Color = Color or Library.Theme.Accent
    
    if Library.Notif.Active then
        table.insert(Library.Notif.Queue, {Text, Duration, Color})
        return
    end
    
    Library.Notif.Active = true
    
    local NotifFrame = Create("Frame", {
        Name = "Notification",
        Parent = Library.ScreenGui,
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -20, 1, -20),
        AnchorPoint = Vector2.new(1, 1),
        Size = UDim2.new(0, 0, 0, 60),
        ClipsDescendants = true
    })
    
    local NotifCorner = Create("UICorner", {
        CornerRadius = UDim.new(0, 6),
        Parent = NotifFrame
    })
    
    local NotifStroke = Create("UIStroke", {
        Color = Library.Theme.Border,
        Thickness = 1,
        Parent = NotifFrame
    })
    
    local NotifText = Create("TextLabel", {
        Name = "Text",
        Parent = NotifFrame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -20, 1, 0),
        Font = Library.Font,
        Text = Text,
        TextColor3 = Library.Theme.Text,
        TextSize = Library.FontSize,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true
    })
    
    local NotifBar = Create("Frame", {
        Name = "Bar",
        Parent = NotifFrame,
        BackgroundColor3 = Color,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2)
    })
    
    local TextSize = GetTextSize(Text, Library.Font, Library.FontSize)
    local Width = math.max(200, TextSize.X + 40)
    
    Tween(NotifFrame, {Size = UDim2.new(0, Width, 0, 60)}, 0.5)
    
    task.delay(Duration, function()
        Tween(NotifFrame, {Size = UDim2.new(0, 0, 0, 60)}, 0.5).Completed:Wait()
        NotifFrame:Destroy()
        Library.Notif.Active = false
        
        if #Library.Notif.Queue > 0 then
            local Next = table.remove(Library.Notif.Queue, 1)
            Library:Notification(Next[1], Next[2], Next[3])
        end
    end)
end

