    -- Init (MODIFIED - Settings tab removed)
    function Window:Init()
        Library.Loaded = true
        
        -- Settings tab creation REMOVED
        -- Theme file writing REMOVED
        
        -- Keybind Handler
        Connect(UserInputService.InputBegan, function(Input, GameProcessed)
            if GameProcessed then return end
            for Flag, Item in pairs(Library.Items) do
                if Item.Type == "Keybind" then
                    if Input.KeyCode == Item.Value then
                        if Item.Mode == "Toggle" then
                            Item.Set(not Item.Get())
                        elseif Item.Mode == "Hold" then
                            Item.Set(true)
                        end
                    end
                end
            end
        end)
        
        Connect(UserInputService.InputEnded, function(Input)
            for Flag, Item in pairs(Library.Items) do
                if Item.Type == "Keybind" then
                    if Input.KeyCode == Item.Value and Item.Mode == "Hold" then
                        Item.Set(false)
                    end
                end
            end
        end)
    end
    
    return Window
end

